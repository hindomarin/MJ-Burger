# Copy this file to .env and fill in your own values.
# Never commit the real .env file to Git.

# Port the API listens on
PORT=4000

# Address of the frontend that is allowed to call this API
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection (used from Step 1 onwards)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mj_juicy_burger"

# Secret used to sign login tokens (used from Step 3 onwards)
JWT_SECRET=change-this-to-a-long-random-string
